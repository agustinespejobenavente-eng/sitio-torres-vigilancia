# Copy to .env (never commit it) or set these in your host's dashboard.

# Mail delivery for quote requests, through Resend (https://resend.com). All three are required.
# Without them /api/quote answers 503 and the form tells the visitor nothing was sent.
RESEND_API_KEY=
# Where requests arrive. Comma separated for several people.
QUOTE_TO=
# A sender on a domain verified in Resend, for example: Sitio web <cotizaciones@su-dominio.cl>
QUOTE_FROM=

# Optional
# PORT=3000
# HOST=0.0.0.0
# Set to 1 only when running behind a reverse proxy you control, so the visitor's IP comes from X-Forwarded-For.
# TRUST_PROXY=1
# Browser origins allowed to post the form. Leave empty to accept the site's own host only.
# ALLOWED_ORIGINS=https://www.su-dominio.cl
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW_MIN=10
